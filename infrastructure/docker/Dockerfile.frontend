FROM python:3.11-slim

WORKDIR /app

# Installer les dependances systeme
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && \
    rm -rf /var/lib/apt/lists/*

# Copier et installer les dependances
COPY requirements.txt .
COPY requirements-frontend.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements-frontend.txt

# Copier le code source
COPY . .

# Exposer le port
EXPOSE 8501

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Commande de demarrage
CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.maxUploadSize=200"]
