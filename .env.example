# ==============================================
# Configuration DataStream AI
# ==============================================
# Copiez ce fichier en .env et remplissez les valeurs

# --- OpenAI ---
OPENAI_API_KEY=sk-votre-cle-openai-ici

# --- Base de donnees ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datastream

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Securite ---
SECRET_KEY=changez-moi-avec-une-vraie-cle-aleatoire-en-production

# --- CORS ---
ORIGINES_AUTORISEES=http://localhost:8501
